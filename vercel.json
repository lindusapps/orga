{
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://fpuaqitqwiarnyimrcjr.supabase.co/auth/v1/:path*"
    },
    {
      "source": "/api/functions/:path*",
      "destination": "https://fpuaqitqwiarnyimrcjr.supabase.co/functions/v1/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
